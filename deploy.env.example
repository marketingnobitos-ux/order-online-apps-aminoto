# Template konfigurasi path untuk deploy.sh.
# Salin file ini menjadi deploy.env lalu sesuaikan untuk server Anda:
#     cp deploy.env.example deploy.env
#
# deploy.env TIDAK ikut git (sudah di-.gitignore), jadi aman menyimpan
# path khusus server di sana tanpa mengubah file yang ter-track.

# Folder repo hasil clone di server.
# Opsional — kalau dikosongkan, otomatis memakai folder tempat deploy.sh berada.
REPO_DIR="/home/ubuntu/projects/aminoto"

# Web root yang dilayani Nginx (WAJIB diisi).
WEB_ROOT="/var/www/aminoto"

# Branch yang di-deploy. Opsional — default: main.
# BRANCH="main"
